DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PayFlowDB
APP_NAME=Platform Suite API
APP_ENV=development
DEBUG=true
JWT_SECRET=change-me-platform-suite-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
# Reset / activation link TTLs in minutes (e.g. 5 for QA, 1440 for 24h prod)
PASSWORD_RESET_EXPIRE_MINUTES=5
ACTIVATION_TOKEN_EXPIRE_MINUTES=5
# Fallback when Origin/Referer is missing (Swagger/Postman).
# Browser invites use the page origin (localhost vs ngrok) automatically.
FRONTEND_URL=http://localhost:5173
PASSWORD_MIN_LENGTH=8
SEED_SUPER_ADMIN_EMAIL=admin@payflow.ai
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_SUPER_ADMIN_NAME=Platform Super Admin
# AI workflow suggestion (Groq) — key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_REASONING_EFFORT=low
# Free tier (8k tokens/min): 3 segments per LLM call. Paid tier: 0 = all in one call.
GROQ_SEGMENTS_PER_CALL=3

# Collection email provider (abstraction):
# 1) SendGrid if SENDGRID_API_KEY + SENDGRID_FROM_EMAIL set
# 2) else SMTP if SMTP_HOST set (opens/clicks not available)
# 3) else log-only to email_logs
# Client email_from / sender_name / brand_name override From on the wire when set.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=PayFlow
# Signed Event Webhook public verification key (SendGrid dashboard → Mail Settings → Event Webhook).
# Leave empty for local/dev (events accepted without signature). Set in production.
# Webhook URL to configure in SendGrid: {API_BASE}/webhooks/sendgrid
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Optional SMTP fallback for collection (and platform mail)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# Collection SMS (Twilio) — empty credentials = log-only to sms_logs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public API base used for Twilio StatusCallback + signature verification
# (e.g. https://api.example.com). Empty = omit StatusCallback (local/dev).
# Webhooks: {PUBLIC_API_BASE}/webhooks/twilio/status
#           {PUBLIC_API_BASE}/webhooks/twilio/inbound  (STOP / opt-out)
PUBLIC_API_BASE=

# Customer payment portal base (opaque token appended: {BASE}/{token}).
# Do not put CRM account references in this URL path.
WORKFLOW_PAYMENT_LINK_BASE=https://pay.payflow.local/pay
# Active payment-link TTL in hours (default 336 = 14 days).
PAYMENT_LINK_TTL_HOURS=336
