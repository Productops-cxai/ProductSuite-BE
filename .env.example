# Local default file: .env
# Production on EC2: copy .env.production.example → .env.production
#   and start with APP_ENV=production (loads .env.production) or DOTENV_FILE=.env.production
#
# Optional secret wrapping (prod): set ENV_MASTER_KEY in the process/systemd env
# (NOT inside the dotenv file). Encrypt values with the Windows tool:
#   Deployment things/PayFlowEnvSecretTool
# then store as: SOME_KEY=enc:gAAAA...

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PayFlowDB

# App
APP_NAME=Platform Suite API
APP_ENV=development
DEBUG=true

# JWT / Auth
JWT_SECRET=change-me-platform-suite-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
# Reset / activation link TTLs in minutes (e.g. 5 for QA, 1440 for 24h prod)
PASSWORD_RESET_EXPIRE_MINUTES=5
ACTIVATION_TOKEN_EXPIRE_MINUTES=5
# Fallback when Origin/Referer is missing (Swagger/Postman).
# Browser invites use the page origin (localhost vs ngrok) automatically.
FRONTEND_URL=http://localhost:5173
PASSWORD_MIN_LENGTH=8

# Seed Platform Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@payflow.ai
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_SUPER_ADMIN_NAME=Platform Super Admin

# Optional SMTP — leave empty to keep email_logs-only mode.
# When set, send_email will attempt real delivery.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# AI workflow suggestion (Groq) — key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_REASONING_EFFORT=low
# Free tier (8k tokens/min): 3 segments per LLM call. Paid tier: 0 = all in one call.
GROQ_SEGMENTS_PER_CALL=3

# Collection email provider (abstraction):
# 1) SendGrid if SENDGRID_API_KEY + SENDGRID_FROM_EMAIL set
# 2) else SMTP if SMTP_HOST set (opens/clicks not available)
# 3) else log-only to email_logs
# Client email_from / sender_name / brand_name override From on the wire when set.
# FROM email must be a verified Sender Identity in SendGrid (Settings → Sender Authentication).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=PayFlow
# Signed Event Webhook public verification key (SendGrid dashboard → Mail Settings → Event Webhook).
# Leave empty for local/dev (events accepted without signature). Set in production.
# Webhook URL to configure in SendGrid: {API_BASE}/webhooks/sendgrid
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Collection SMS (Twilio) — empty credentials = log-only to sms_logs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public API base used for Twilio StatusCallback + signature verification
# (e.g. https://api.example.com). Empty = omit StatusCallback (local/dev).
# Webhooks: {PUBLIC_API_BASE}/webhooks/twilio/status
#           {PUBLIC_API_BASE}/webhooks/twilio/inbound  (STOP / opt-out)
#           {PUBLIC_API_BASE}/webhooks/stripe
PUBLIC_API_BASE=

# Workflow worker (PostgreSQL due-queue)
WORKFLOW_WORKER_ID=
WORKFLOW_WORKER_CONCURRENCY=8
WORKFLOW_WORKER_BATCH_SIZE=50
WORKFLOW_WORKER_SWEEP_SECONDS=20
WORKFLOW_WORKER_STALE_SECONDS=300
WORKFLOW_JOB_NOTIFY_CHANNEL=workflow_jobs

# Customer payment portal base (opaque token appended: {BASE}/{token}).
# Empty → {FRONTEND_URL}/pay  (recommended for local).
# Do not put CRM account references in this URL path.
WORKFLOW_PAYMENT_LINK_BASE=
# Active payment-link TTL in hours (default 336 = 14 days).
PAYMENT_LINK_TTL_HOURS=336

# Stripe Checkout (empty STRIPE_SECRET_KEY → local mock checkout in development).
# Webhook URL: {PUBLIC_API_BASE}/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Third Party clients show operator branding on the customer portal.
PAYFLOW_OPERATOR_BRAND_NAME=PayFlow Collections
PAYFLOW_OPERATOR_LOGO_URL=

# Uploads: empty S3_BUCKET = local ./uploads. Prod: bucket name + EC2 IAM role.
S3_BUCKET=
AWS_REGION=ca-central-1

# CORS: empty = allow all in development; in production = FRONTEND_URL (+ www).
# Or set explicit list: https://testatncri.com,https://www.testatncri.com
CORS_ORIGINS=
