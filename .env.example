DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PayFlowDB
APP_NAME=Platform Suite API
APP_ENV=development
DEBUG=true
JWT_SECRET=change-me-platform-suite-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
# Reset / activation link TTLs in minutes (e.g. 5 for QA, 1440 for 24h prod)
PASSWORD_RESET_EXPIRE_MINUTES=5
ACTIVATION_TOKEN_EXPIRE_MINUTES=5
# Fallback when Origin/Referer is missing (Swagger/Postman).
# Browser invites use the page origin (localhost vs ngrok) automatically.
FRONTEND_URL=http://localhost:5173
PASSWORD_MIN_LENGTH=8
SEED_SUPER_ADMIN_EMAIL=admin@payflow.ai
SEED_SUPER_ADMIN_PASSWORD=Admin@12345
SEED_SUPER_ADMIN_NAME=Platform Super Admin
# AI workflow suggestion (Groq) — key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_REASONING_EFFORT=low
# Free tier (8k tokens/min): 3 segments per LLM call. Paid tier: 0 = all in one call.
GROQ_SEGMENTS_PER_CALL=3

# Collection email (SendGrid) — empty key = log-only to email_logs
# FROM must be a verified Sender Identity in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=PayFlow
# Signed Event Webhook public verification key (SendGrid dashboard → Mail Settings → Event Webhook).
# Leave empty for local/dev (events accepted without signature). Set in production.
# Webhook URL to configure in SendGrid: {API_BASE}/webhooks/sendgrid
SENDGRID_WEBHOOK_VERIFICATION_KEY=
