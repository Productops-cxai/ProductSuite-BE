# Copy to .env.production on the EC2 host (never commit the real file).
# Start API/worker with:
#   APP_ENV=production
#   ENV_MASTER_KEY=<same key as PayFlowEnvSecretTool>   # only if you use enc: values
# Optional override: DOTENV_FILE=.env.production
#
# Encrypt secrets with Windows tool:
#   Deployment things/PayFlowEnvSecretTool
# Paste result as: SOME_KEY=enc:gAAAA...

DATABASE_URL=postgresql+psycopg2://payflow_admin:CHANGE_ME@payflow-db.XXXX.ca-central-1.rds.amazonaws.com:5432/PayFlowDB

APP_NAME=Platform Suite API
APP_ENV=production
DEBUG=false

JWT_SECRET=enc:REPLACE_AFTER_ENCRYPT
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=1440
ACTIVATION_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=https://testatncri.com
# Optional extra origins (comma-separated). Empty = FRONTEND_URL + www twin.
CORS_ORIGINS=

SEED_SUPER_ADMIN_EMAIL=admin@yourdomain.com
SEED_SUPER_ADMIN_PASSWORD=enc:REPLACE_AFTER_ENCRYPT
SEED_SUPER_ADMIN_NAME=Platform Super Admin
PASSWORD_MIN_LENGTH=8

SENDGRID_API_KEY=enc:REPLACE_AFTER_ENCRYPT
SENDGRID_FROM_EMAIL=payflow@email.ncri.ca
SENDGRID_FROM_NAME=PayFlow
SENDGRID_WEBHOOK_VERIFICATION_KEY=enc:REPLACE_AFTER_ENCRYPT

TWILIO_ACCOUNT_SID=enc:REPLACE_AFTER_ENCRYPT
TWILIO_AUTH_TOKEN=enc:REPLACE_AFTER_ENCRYPT
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
PUBLIC_API_BASE=https://api.testatncri.com

WORKFLOW_WORKER_CONCURRENCY=8
WORKFLOW_WORKER_BATCH_SIZE=50
WORKFLOW_WORKER_SWEEP_SECONDS=20
WORKFLOW_WORKER_STALE_SECONDS=300
WORKFLOW_JOB_NOTIFY_CHANNEL=workflow_jobs
WORKFLOW_PAYMENT_LINK_BASE=https://testatncri.com/pay
PAYMENT_LINK_TTL_HOURS=336

STRIPE_SECRET_KEY=enc:REPLACE_AFTER_ENCRYPT
STRIPE_WEBHOOK_SECRET=enc:REPLACE_AFTER_ENCRYPT
STRIPE_PUBLISHABLE_KEY=
PAYFLOW_OPERATOR_BRAND_NAME=PayFlow Collections
PAYFLOW_OPERATOR_LOGO_URL=

# S3 uploads (EC2 IAM role — no AWS access keys in this file)
S3_BUCKET=payflow-prod-uploads-ca
AWS_REGION=ca-central-1

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_REASONING_EFFORT=low
GROQ_SEGMENTS_PER_CALL=3
